# Production environment variables
# Copy this file to `.env` on the production server and fill in real values.

NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# Frontend URLs (for CORS)
FRONTEND_URL_CITIZEN=https://maliretrouve.ml
FRONTEND_URL_AGENT=https://agent.maliretrouve.ml
FRONTEND_URL_ADMIN=https://admin.maliretrouve.ml

# Database (use a real PostgreSQL instance)
DATABASE_URL=postgresql://mrt_user:REPLACE_WITH_REAL_PASSWORD@db.example.com:5432/mrt_prod?schema=public

# Redis (use a real Redis instance)
REDIS_URL=redis://REPLACE_WITH_REAL_REDIS_HOST:6379
REDIS_TTL_SECONDS=3600

# MinIO / S3-compatible storage
MINIO_ENDPOINT=s3.example.com
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=REPLACE_WITH_REAL_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_REAL_SECRET_KEY
MINIO_BUCKET_MRT=mrt-prod
MINIO_REGION=us-east-1

# JWT / Sessions (USE STRONG RANDOM VALUES IN PRODUCTION)
JWT_SECRET=REPLACE_WITH_REAL_JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_REAL_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h
SESSION_SECRET=REPLACE_WITH_REAL_SESSION_SECRET

# Password hashing
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

# OTP
OTP_LENGTH=6
OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60

# SMS Provider (use real provider in production)
SMS_PROVIDER=console
SMS_CONSOLE_ENABLED=false

# Email Provider (use real provider in production)
EMAIL_PROVIDER=console
EMAIL_CONSOLE_ENABLED=false

# Matching thresholds
MATCHING_THRESHOLD_HIGH=80
MATCHING_THRESHOLD_LOW=50
MATCHING_TIME_WINDOW_DAYS=60
MATCHING_MAX_CANDIDATES=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Audit / security
AUDIT_CHAIN_ENABLED=true
POLICIES_RETENTION_ACTIVE_DAYS=365
POLICIES_RETENTION_ARCHIVED_DAYS=1095
