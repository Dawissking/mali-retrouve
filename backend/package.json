{
  "name": "@mrt/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:workers:matching": "tsx watch src/workers/matchingWorker.ts",
    "dev:workers:notification": "tsx watch src/workers/notificationWorker.ts",
    "dev:workers:purge": "tsx watch src/workers/purgeWorker.ts",
    "dev:workers:expiration": "tsx watch src/workers/expirationWorker.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "jest --maxWorkers=2",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageThreshold='{\"global\":{\"lines\":80,\"branches\":70,\"functions\":80,\"statements\":80}}'",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "argon2": "^0.41.1",
    "aws-sdk": "^2.1040.0",
    "bullmq": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^1000.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-zod-api": "^18.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.2.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "speakeasy": "^2.0.0",
    "uuid": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.2",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "dotenv-flow": "^4.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "qrcode": "^1.5.4",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  }
}
