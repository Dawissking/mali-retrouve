# =============================================================================
# MALI RETROUVÉ — Environment Configuration (MVP Development)
# =============================================================================
# Copy this file to `.env` and adjust as needed for your local environment.
# The `.env` file is git-ignored and must NEVER be committed.

# ---- Server ----
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ---- Frontend URLs (for CORS) ----
FRONTEND_URL_CITIZEN=http://localhost:5173
FRONTEND_URL_AGENT=http://localhost:5174
FRONTEND_URL_ADMIN=http://localhost:5175

# ---- Database (PostgreSQL via Podman Machine) ----
# Note: When using Podman Machine on Windows, use the machine's WSL2 IP
# instead of localhost to avoid conflicts with local services.
# Get the IP with: wsl -d podman-mrt-machine ip addr show eth0 | Select-String "inet "
DATABASE_URL="postgresql://mrt_user:mrt_password_123@172.21.98.144:5432/mrt_dev?schema=public"

# ---- Redis (via Podman Machine) ----
REDIS_URL="redis://172.21.98.144:6379"
REDIS_TTL_SECONDS=3600

# ---- MinIO / S3-compatible storage (via Podman Machine) ----
MINIO_ENDPOINT=172.21.98.144
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=mrt_minio_root
MINIO_SECRET_KEY=mrt_minio_password_123
MINIO_BUCKET_MRT=mrt-dev
MINIO_REGION=us-east-1

# ---- JWT / Sessions ----
JWT_SECRET=dev-jwt-secret-change-in-production-32chars-min
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h
SESSION_SECRET=dev-session-secret-change-in-prod-32chars

# ---- Password hashing (Argon2) ----
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

# ---- OTP (SMS OTP for citizen finder verification) ----
OTP_LENGTH=6
OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60

# ---- SMS Provider (MVP development mode) ----
SMS_PROVIDER=console
SMS_CONSOLE_ENABLED=true
# When set to a real provider:
# SMS_PROVIDER=twilio
# SMS_TWILIO_ACCOUNT_SID=xxx
# SMS_TWILIO_AUTH_TOKEN=xxx
# SMS_TWILIO_FROM=+1234567890

# ---- Email Provider (MVP development mode) ----
EMAIL_PROVIDER=console
EMAIL_CONSOLE_ENABLED=true
# When set to a real provider:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=xxx
# SMTP_PASS=xxx

# ---- Matching thresholds (configurable) ----
# High threshold: score >= this => CORRESPONDANCE_TROUVEE (notify citizen + agent)
MATCHING_THRESHOLD_HIGH=80
# Low threshold: score >= this => CORRESPONDANCE_TROUVEE (candidate to agent)
MATCHING_THRESHOLD_LOW=50
# Temporal window in days for matching candidates
MATCHING_TIME_WINDOW_DAYS=60
# Max candidates per declaration
MATCHING_MAX_CANDIDATES=10

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- Audit / security ----
AUDIT_CHAIN_ENABLED=true
POLICIES_RETENTION_ACTIVE_DAYS=365
POLICIES_RETENTION_ARCHIVED_DAYS=1095
